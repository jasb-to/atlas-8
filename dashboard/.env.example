# Server-only secrets; never prefix these with NEXT_PUBLIC_
FRIDAY_SUPABASE_URL=https://YOUR-RESEARCH-PROJECT.supabase.co
FRIDAY_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional free-tier AI failover (Gemini -> Groq -> Hugging Face)
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Optional; defaults to openai/gpt-oss-120b
FRIDAY_GROQ_MODEL_ID=openai/gpt-oss-120b
