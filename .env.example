# Friday local environment template
# Copy to .env locally; never commit local.env or any file containing real tokens.

# Hugging Face Inference Router (optional shadow review; defaults are in code)
HUGGINGFACE_API_KEY=REPLACE_WITH_YOUR_TOKEN

# Upstash Redis REST (preferred persistence/cache backend)
UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_YOUR_UPSTASH_ENDPOINT
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_UPSTASH_REST_TOKEN

# Kraken request pacing / universe controls
FRIDAY_KRAKEN_REQUEST_GAP_SECONDS=1.25
FRIDAY_MIN_QUOTE_VOLUME_USD=5000000
FRIDAY_MAX_MARKETS_PER_SCAN=40

# Standalone Stoch RSI reversal scanner (disabled; weekly thesis remains authoritative)
FRIDAY_MOMENTUM_REVERSAL_ENABLED=false
